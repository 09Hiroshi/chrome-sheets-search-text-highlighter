{
  "manifest_version": 3,
  "name": "Sheets Search Text Highlighter",
  "version": "1.1.1",
  "description": "Google スプレッドシートで検索した文字のみを、セルの編集欄や数式バーでハイライトします。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/spreadsheets/*"
      ],
      "js": [
        "color-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://docs.google.com/spreadsheets/*"
      ],
      "js": [
        "highlight.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "ハイライトの色を設定",
    "default_popup": "popup.html"
  }
}
