{
  "manifest_version": 3,
  "name": "Sheets Search Text Highlighter",
  "version": "1.0.0",
  "description": "Google スプレッドシートで検索した文字に、セルの編集欄や数式バーで背景色を付けて見やすくします（一部の表示に対応）。",
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/spreadsheets/*"
      ],
      "js": [
        "highlight.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
